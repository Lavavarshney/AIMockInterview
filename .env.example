

# Clerk authentication:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Gemini provider:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_QUESTION_MODEL=gemini-2.5-flash
# GEMINI_EVALUATION_MODEL=gemini-2.5-flash

# Optional OpenRouter fallback, useful when individual provider free limits are hit:
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
OPENROUTER_QUESTION_MODEL=google/gemini-2.0-flash-001
OPENROUTER_EVALUATION_MODEL=google/gemini-2.0-flash-001

# Optional Groq fallback:
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_QUESTION_MODEL=llama-3.3-70b-versatile
# GROQ_EVALUATION_MODEL=llama-3.3-70b-versatile

# Optional OpenAI fallback:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_QUESTION_MODEL=gpt-4o-mini
# OPENAI_EVALUATION_MODEL=gpt-4o
